# PostgreSQL接続情報
PGHOST=localhost
PGPORT=5432
PGDATABASE=bus_realtime
PGUSER=postgres
PGPASSWORD=postgres

# サーバーポート
PORT=3000

# リアルタイム位置情報取得先（複数フィード対応）
# 位置情報CSVとGTFSの取得先は feeds テーブルで管理される。
# 初期値は seed.js の DEFAULT_FEEDS で投入される。
# 位置情報CSV:
♯   -matsumotoshicombus:  https://dashboard.wakoticket.net/information/matsumotoshicombus/latlon.csv
#   - alpicokotsu:        https://dashboard.wakoticket.net/information/alpicokotsu/latlon.csv
#   - matsumotoshiei:     https://dashboard.wakoticket.net/information/matsumotoshiei/latlon.csv
# GTFS ZIP:
#   - guruttomatsumotobus1: https://api.gtfs-data.jp/v2/organizations/matsumotocity/feeds/guruttomatsumotobus1/files/feed.zip?rid=current
#   - guruttomatsumotobus2: https://api.gtfs-data.jp/v2/organizations/matsumotocity/feeds/guruttomatsumotobus2/files/feed.zip?rid=current
# 位置情報CSV⇔GTFSの対応関係は feed_mappings テーブルで動的に管理される。

# バス停通過判定の許容半径（メートル）。GAS版の緯度経度レンジ設定に相当。
STOP_RADIUS_METERS=120
# 運行終了エリア（その便の終点）の判定半径（メートル）
END_AREA_RADIUS_METERS=150
# 割り当てから何分経過した便の割り当てを強制終了するか
VEHICLE_MAX_AGE_MIN=120
# 運行終了判定を開始しない保護期間（分）
FINISH_PROTECTION_MIN=10
# GPSデータの有効期限（分）：これより古いGPS点は通過判定に使わない
GPS_FRESHNESS_MIN=15
# 深夜運行停止時間帯。当日便の生成と車両割り当てはこの時間帯でも動く
# （最も早い便が5:40発のため、深夜帯にすべて止めると当日便が間に合わない）。
NIGHT_START=23:00
NIGHT_END=05:00

# ---- 便への車両割り当て（便起点方式）----
# 候補車両とみなす、始発バス停からの距離（メートル）
ASSIGN_RADIUS_METERS=100
# 始発時刻から何分前まで遡ってGPSを探すか（始発時刻との閉区間）
ASSIGN_GPS_WINDOW_MIN=3
# 始発時刻から何秒待ってから割り当て判定を行うか。
# 位置情報フィードの配信遅れを吸収する。判定に使うGPSの時間窓は変わらない。
ASSIGN_DELAY_SEC=60
# 「同時刻帯」とみなす始発時刻の差（分）。この範囲の便どうしでは
# 同じ車両を担当車両として重複させない。例：8:00便の担当車両は8:11便の担当になれる。
ASSIGN_SAME_PERIOD_MIN=10

# ---- データ保持期間 ----
# 当日便(daily_trips)の保持日数
DAILY_TRIP_RETENTION_DAYS=7
# GPSログ(vehicle_gps_log)の保持時間。車両行を削除しなくなったため明示的に掃除する。
GPS_LOG_RETENTION_HOURS=48

# ポーリング間隔（秒）
POLL_INTERVAL_SECONDS=60

# GTFSフィード更新間隔（分）。0以下の場合は毎回更新する。
GTFS_UPDATE_INTERVAL_MIN=60

# アルピコ交通「現在の運行状況」ページのスクレイピング設定（/servicestatus 画面用）
ALPICO_STATUS_URL=https://www.alpico.co.jp/traffic/trafficinfo/matsumoto/
SERVICE_STATUS_POLL_INTERVAL_MIN=60