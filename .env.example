# docker compose 用の環境変数ファイル。
# 使い方: このファイルを .env としてコピーし、必要に応じて値を編集してください。
#   cp .env.example .env
# docker-compose.yml が自動的にこの .env を読み込みます（変数展開 & backendコンテナへの注入）。
#
# 位置情報フィード・GTFS ZIPフィードのURL、および両者の対応は環境変数ではなく
# backend/src/config/feeds.js（コード）で管理されています。ここには含まれません。

# ---- PostgreSQL（dbコンテナ） ----
POSTGRES_DB=bus_realtime
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- バックエンド接続情報（backendコンテナ。PGHOSTはcompose上のサービス名 "db" を指す） ----
# DATABASE_URL を指定した場合はそちらが優先されます（Render等ホスティング向け、SSL接続前提）。
PGHOST=db
PGPORT=5432
PGDATABASE=bus_realtime
PGUSER=postgres
PGPASSWORD=postgres
PORT=3000

# ---- 管理画面ログイン（Basic認証） ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- パイプライン・判定しきい値・運用パラメータ（省略時は各サービスの既定値を使用） ----
# これらの値は管理画面「運用パラメータ設定」（/api/admin/runtime-settings）からも編集できる。
# 優先順位: 管理画面での上書き値(DB) > ここでの環境変数 > コード既定値。
# 管理画面で編集しなければ、これまでどおりこのファイルの値だけで動く。
POLL_INTERVAL_SECONDS=60
GTFS_UPDATE_INTERVAL_MIN=60
GPS_FRESHNESS_MIN=15
ASSIGN_RADIUS_METERS=100
ASSIGN_GPS_WINDOW_MIN=3
ASSIGN_DELAY_SEC=60
ASSIGN_SAME_PERIOD_MIN=10
STOP_RADIUS_METERS=120
# GPSがこの時間（分）以上更新されていない車両を「GPS途絶」とみなす
# （短すぎると一時的な測位不良で便がリアルタイム表示から外れやすくなる）
GPS_STALE_TIMEOUT_MIN=6
VEHICLE_MAX_AGE_MIN=120
FINISH_PROTECTION_MIN=10
DAILY_TRIP_RETENTION_DAYS=7
GPS_LOG_RETENTION_HOURS=48
# 運行実績アーカイブ(completed_trips)の保持日数。区間平均(segment_travel_stats)は
# クローズ時に反映済みのため影響なし。管理画面「運行実績ダウンロード」でエクスポート
# できるのもこの期間内の便だけになる。
COMPLETED_TRIP_RETENTION_DAYS=7
# 区間統計の実効サンプル数上限。超えると指数移動平均に切り替わり、古い実績を徐々に忘れる。
SEGMENT_STATS_MAX_SAMPLES=500
ETA_BLEND_WEIGHT=0.55
NIGHT_START=23:00
NIGHT_END=05:00

# ---- 管理画面ダッシュボードの監視しきい値（分。省略時は各既定値を使用） ----
ADMIN_STALE_GPS_MIN=5
ADMIN_DELAY_ALERT_MIN=5
ADMIN_SEVERE_DELAY_MIN=15
ADMIN_UNASSIGNED_OVERDUE_MIN=5
ADMIN_ETA_STALE_MIN=10

# ---- アルピコ交通 運行状況スクレイピング ----
SERVICE_STATUS_POLL_INTERVAL_MIN=60
ALPICO_STATUS_URL=https://www.alpico.co.jp/traffic/trafficinfo/matsumoto/

# ---- サイト閲覧数（同時アクセス数）が高負荷とみなされる人数 ----
HIGH_LOAD_VIEWER_THRESHOLD=50
